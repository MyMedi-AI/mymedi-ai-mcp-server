{
  "name": "@mymedi-ai/mcp-server",
  "version": "1.7.6",
  "description": "MCP server for DME billing and medical coding: HCPCS, ICD-10 and CPT lookup, DMEPOS fee schedules, Medicare prior-auth and F2F checks, denial codes, claim checks. 32 tools, 6 free. PHI-free.",
  "mcpName": "io.github.MyMedi-AI/mcp-server",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "bin": {
    "mymedi-ai-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "dme",
    "dmepos",
    "medicare",
    "prior-authorization",
    "medical-billing",
    "medical-coding",
    "hcpcs",
    "icd-10",
    "cpt",
    "denial-codes",
    "claims",
    "healthcare",
    "claude-desktop"
  ],
  "scripts": {
    "build": "echo 'No build step required — MCP server runs directly from src/index.js'",
    "test": "node --test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyMedi-AI/mymedi-ai-mcp-server.git"
  },
  "homepage": "https://mymedi-ai.com",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "bugs": {
    "url": "https://github.com/MyMedi-AI/mymedi-ai-mcp-server/issues"
  }
